					</winHandler>
				</branch>
				<branch id="resident_miracle">
					<settings count="1">
						<mode>4</mode>
					</settings>
					<enemy>
						<pet id="20016" level="105">
							<status>
								<hp>25000</hp>
							</status>
							<initBuff>-8,61,-3130</initBuff>
							<loopSkill>15158,15160,15161,15162</loopSkill>
						</pet>
					</enemy>
					<winHandler>
						<button type="auto">
							<action>setPet</action>
							<param>maxLevel=105</param>
							<param>level=105</param>
						</button>
						<button type="auto">
							<action>evolvePet</action>
							<param>20016</param>
						</button>
						<button type="auto">
							<action>openHintbox</action>
							<param>type=Item</param>
							<param>title=提示</param>
							<param>content=神迹月神已常驻神迹形态</param>
							<param>item_icon=pet[827]</param>
							<param>option_num=1</param>
