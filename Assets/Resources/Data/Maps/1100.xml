			<eventHandler>
				<button type="click">
					<action>openDialog</action>
					<param>default</param>
				</button>
			</eventHandler>
			<callbackHandler>
				<button type="choose">
					<action>openHintbox</action>
					<param>type=PetSelect</param>
				    <param>title=选择要进化的圣光月神</param>
				    <param>option_num=2</param>
					<param>callback=evolve</param>
				    <condition>data.PetSelect.uidNOT530|data.PetSelect.level&lt;100</condition>
				</button>
				<button type="evolve">
				    <action>openHintbox</action>
				    <param>type=Item</param>
				    <param>title=提示</param>
				    <param>content=必须选择等级100的圣光月神！</param>
				    <param>item_icon=pet[530]</param>
				    <param>option_num=1</param>
					<param>callback=choose</param>
				    <condition>data.PetSelect.uidNOT530|data.PetSelect.level&lt;100</condition>
				</button>
				<button type="evolve">
				    <action>openHintbox</action>
				    <param>type=Item</param>
				    <param>title=提示</param>
				    <param>content=圣光月神已成功超进化</param>
				    <param>item_icon=pet[817]</param>
				    <param>option_num=1</param>
				    <condition>data.PetSelect.uid=530</condition>
				    <condition>data.PetSelect.levelGTE100</condition>
				</button>
				<button type="evolve">
				    <action>evolvePet</action>
				    <param>index=data.PetSelectIndex</param>
				    <param>817</param>
				    <condition>data.PetSelect.uid=530</condition>
				    <condition>data.PetSelect.levelGTE100</condition>
				</button>
			</callbackHandler>
		</npc>
		<!-- <teleport id="1" name="异蘑小径" pos="810,200" targetMapId="123"/> -->
	</entities>
