			<description>月神</description>
			<dialog>
				<branch id="default" name="圣光月神" icon="Pets/pet/530" size="139,123" pos="0,45">
					<content>不知天上宫阙，今夕是何年</content>
					<functionHandler>
						<func type="click">
							<description><![CDATA[圣光月神]]></description>
							<action>openPanel</action>
							<param>TwelveRound</param>
							<param>pet=530</param>
							<param>pos=-10,70</param>
							<param>size=216,238</param>
							<param>item[2]=10239[1]</param>
							<param>item[5]=9008[3]</param>
							<param>item[8]=2[50]</param>
							<param>item[10]=10242[1]</param>
							<param>item[12]=320530[1]</param>
						</func>
						<func type="click">
							<description><![CDATA[神迹觉醒]]></description>
							<action>battle</action>
							<param>miracle</param>
						</func>
						<func type="click">
							<description><![CDATA[常态神迹]]></description>
							<action>battle</action>
							<param>resident_miracle</param>
							<condition>firstPet.uid=817</condition>
						</func>
						<func type="branch">
							<action>openHintbox</action>
							<param>type=Item</param>
							<param>title=提示</param>
							<param>content=将神迹月神设为首发吧</param>
							<param>item_icon=pet[817]</param>
							<param>option_num=1</param>
							<condition>firstPet.uidNOT817</condition>
						</func>	
					</functionHandler>
					<replyHandler>
						<reply type="click">
							<description><![CDATA[我欲乘风归去，又恐琼楼玉宇]]></description>
							<action>openDialog</action>
							<param>null</param>
						</reply>
					</replyHandler>
				</branch>
			</dialog>
			<battle>
				<branch id="miracle">
					<settings count="6">
						<mode>4</mode>
					</settings>
					<enemy>
						<pet id="20016" level="105">
							<status>
								<hp>25000</hp>
							</status>
							<initBuff>-8,97,-3,2122,-3112,-3059,-3118,93</initBuff>
							<loopSkill>15158,15160,15161,15162</loopSkill>
