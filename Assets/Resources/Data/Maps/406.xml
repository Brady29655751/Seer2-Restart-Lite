<map name="冰沁神殿"  category="5"  id="406"  weather="4">
	<!-- <resource>10011</resource> -->
	<initialPoint>350,90</initialPoint>
	<music category="5">
		<bgm>BGM_041</bgm>
	</music>
	<entities>
		<npc id="40601" resId="Pets/pet/984" name="Lv 105 沁灵兽" size="280,209" pos="280,140" namePos="30,0">
			<anim id="Pets/anim/984" pos="0,0" scale="1.65,1.65" />
			<description><![CDATA[沁灵兽]]></description>
			<dialog>
				<branch id="default" name="沁灵兽" icon="Pets/pet/984" size="140,105" pos="0,55">
					<content><![CDATA[我是精灵王之心脏，冰沁氏族不朽的守护者]]></content>
					<functionHandler>
						<func type="click">
							<description><![CDATA[挑战沁灵兽]]></description>
							<action>battle</action>
							<param>default</param>
						</func>
						<func type="click">
							<description><![CDATA[超进化]]></description>
							<action>battle</action>
							<param>evolve</param>
						</func>
					</functionHandler>
					<replyHandler>
						<reply type="click">
							<description><![CDATA[沁灵兽居然不是那位狐狸]]></description>
							<action>openDialog</action>
							<param>null</param>
						</reply>
					</replyHandler>
				</branch>
			</dialog>
			<battle>
				<branch id="default">
					<settings count="6">
						<weather>4</weather>
					</settings>
					<enemy>
						<pet id="984" level="105">
							<status>
								<hp>25000</hp>
							</status>
							<initBuff>14,17,20,-3038</initBuff>
							<loopSkill>11368,11366,11365,11373</loopSkill>
							<superSkill>11371</superSkill>
						</pet>
					</enemy>
					<winHandler>
						<button type="auto">
							<action>getPet</action>
							<param>984,100</param>
							<condition>activity[soul].done[north][4]=[bool]false[default]false</condition>
						</button>
						<button type="auto">
							<action>openHintbox</action>
							<param>type=Item</param>
							<param>title=提示</param>
							<param>content=【沁灵兽】已经放入精灵仓库</param>
							<param>item_icon=pet[984]</param>
							<param>option_num=1</param>
							<condition>activity[soul].done[north][4]=[bool]false[default]false</condition>
						</button>
						<button type="auto">
							<action>setActivity</action>
							<param>soul</param>
							<param>done[north][4]=true</param>
							<condition>activity[soul].done[north][4]=[bool]false[default]false</condition>
						</button>
						<button type="auto">
							<action>setItem</action>
							<param>add</param>
							<param>23008,1</param>
							<condition>random[old]&lt;10</condition>
						</button>
						<button type="auto">
							<action>openHintbox</action>
							<param>type=Item</param>
							<param>title=提示</param>
							<param>content=1个冰沁璞玉已经放入背包</param>
							<param>item_icon=buff[430008]</param>
							<param>option_num=1</param>
							<condition>random[old]&lt;10</condition>
						</button>		
					</winHandler>
				</branch>
				<branch id="evolve">
					<settings count="6">
						<weather>4</weather>
						<initBuff>(field:600004)</initBuff>
						<limit>(elementNOT3)(elementNOT12)</limit>
						<limitDesc><![CDATA[不可以使用<color=#ffbb33>火系</color>和<color=#ffbb33>特质系</color>精灵进行挑战哦！]]></limitDesc>
					</settings>
					<enemy>
						<pet id="994" level="105">
							<status>
								<atk>3200</atk>
								<mat>3200</mat>
								<def>100</def>
								<mdf>100</mdf>
								<hp>250000</hp>
							</status>
							<initBuff>-8,17,20,61,-3112,-3082,-3039,92,93,-3123,-3105,3182,44,-3133,-3134</initBuff>
							<loopSkill>15387,15390</loopSkill>
						</pet>
					</enemy>
					<winHandler>
						<button type="choose">
							<action>openHintbox</action>
							<param>type=PetSelect</param>
						    <param>title=选择要进化的沁灵兽</param>
						    <param>option_num=2</param>
							<param>callback=evolve</param>
						</button>
					</winHandler>
				</branch>
			</battle>
			<eventHandler>
				<button type="click">
					<action>openDialog</action>
					<param>default</param>
				</button>
			</eventHandler>
			<callbackHandler>
				<button type="choose">
					<action>openHintbox</action>
					<param>type=PetSelect</param>
				    <param>title=选择要进化的沁灵兽</param>
				    <param>option_num=2</param>
					<param>callback=evolve</param>
				    <condition>data.PetSelect.uidNOT984|data.PetSelect.level&lt;100</condition>
				</button>
				<button type="evolve">
				    <action>openHintbox</action>
				    <param>type=Item</param>
				    <param>title=提示</param>
				    <param>content=必须选择等级100的沁灵兽！</param>
				    <param>item_icon=pet[984]</param>
				    <param>option_num=1</param>
					<param>callback=choose</param>
				    <condition>data.PetSelect.uidNOT984|data.PetSelect.level&lt;100</condition>
				</button>
				<button type="evolve">
				    <action>openHintbox</action>
				    <param>type=Item</param>
				    <param>title=提示</param>
				    <param>content=沁灵兽已成功超进化</param>
				    <param>item_icon=pet[994]</param>
				    <param>option_num=1</param>
				    <condition>data.PetSelect.uid=984</condition>
				    <condition>data.PetSelect.levelGTE100</condition>
				</button>
				<button type="evolve">
				    <action>evolvePet</action>
				    <param>index=data.PetSelectIndex</param>
				    <param>994</param>
				    <condition>data.PetSelect.uid=984</condition>
				    <condition>data.PetSelect.levelGTE100</condition>
				</button>
			</callbackHandler>
		</npc>
		<teleport id="1" name="冰沁宫殿" pos="480,60" targetMapId="405"/>

	</entities>


</map>

